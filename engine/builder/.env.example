# The form-engine CLI loads .env (personal overrides), then .env.development
# (written by scripts/bootstrap-env.mjs on first run).

# ── Models (REQUIRED for generate-catalog and generate-bindings) ────────────
ANTHROPIC_API_KEY=sk-ant-...
# One model for every AI step. Defaults: Sonnet labels fields, Opus drafts
# bindings. Haiku makes a cheap draft.
# FORMS_PIPELINE_MODEL=claude-haiku-5-5

# ── Canon ───────────────────────────────────────────────────────────────────
# generate-bindings searches Canon over MCP (npm run dev:canon).
# CANON_URL=http://127.0.0.1:4112
# CANON_API_TOKEN=                          # only if Canon enforces one
