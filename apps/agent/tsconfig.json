{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "types": ["node"],
    "paths": {
      "@openreturn/canon": ["../../canon/src/index.ts"],
      "@openreturn/engine": ["../../packages/engine/src/index.ts"],
      "@openreturn/engine/facts": ["../../packages/engine/src/facts/index.ts"],
      "@openreturn/engine/catalog": ["../../packages/engine/src/catalog.ts"],
      "@openreturn/engine/paths": ["../../packages/engine/paths.ts"],
      "@openreturn/engine/scenarios": ["../../packages/engine/tests/scenarios/index.ts"],
      "@openreturn/sources": ["../../packages/sources/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts", "evals/**/*.ts"],
  "exclude": ["node_modules", ".mastra"]
}
