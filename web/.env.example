# Local data files — must point at the SAME paths as the agent's env (the web
# server reads the app DB and document blobs directly; same box by design).
APP_DB_PATH=/absolute/path/to/cade/.data/app.db
DOCUMENTS_PATH=/absolute/path/to/cade/.data/documents

# Where the Next server forwards /api/agent/* (server-side; the browser never
# talks to the agent directly). Default matches `mastra dev`.
# AGENT_INTERNAL_URL=http://127.0.0.1:4111

# Attach this when the agent enforces AGENT_API_TOKEN (agent reachable beyond
# localhost). Leave unset for the localhost default.
# AGENT_API_TOKEN=

# Canon (the reference library) — same pattern: where the Next server reaches
# it, and the token to attach when Canon enforces CANON_API_TOKEN.
# CANON_INTERNAL_URL=http://127.0.0.1:4112
# CANON_API_TOKEN=

# Other devices on your LAN (e.g. a phone) that may load the dev server:
# your machine's LAN IP and/or .local hostname, comma-separated.
# DEV_ALLOWED_ORIGINS=192.168.1.20,my-laptop.local
