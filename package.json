{
  "name": "summa",
  "version": "0.1.0",
  "private": true,
  "description": "Summa monorepo. apps/agent is the Mastra-based AI CPA backend; apps/web is the Next.js frontend; packages/engine is the form engine; packages/sources holds the IRS/FTB source documents (forms, instructions, publications) by tax year. apps/agent and packages/* are npm workspaces; web installs on its own.",
  "workspaces": [
    "apps/agent",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --prefix apps/agent run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:all": "concurrently -k -n agent,web -c cyan,magenta \"npm:dev\" \"npm:dev:web\"",
    "reset": "npm --prefix apps/agent run reset:data",
    "corpus": "npm --prefix apps/agent run corpus --",
    "bootstrap": "node scripts/bootstrap-env.mjs",
    "predev": "node scripts/bootstrap-env.mjs",
    "predev:web": "node scripts/bootstrap-env.mjs",
    "build": "npm --prefix apps/agent run build",
    "build:web": "npm --prefix apps/web run build",
    "start": "npm --prefix apps/agent run start",
    "form-engine": "npm --prefix apps/agent run form-engine --",
    "smoke:review": "npm --prefix apps/agent run smoke:review",
    "doctor": "npm --prefix apps/agent run doctor",
    "test": "npm -w packages/engine test",
    "test:unit": "npm -w packages/engine run test:unit && npm -w apps/agent run test:unit",
    "test:integration": "npm -w packages/engine run test:integration && npm -w apps/agent run test:integration",
    "e2e": "playwright test -c e2e",
    "install:all": "npm install && npm --prefix apps/web install",
    "prepare": "husky",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,js}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,js}\"",
    "typecheck": "npm -w packages/engine run typecheck && npm -w apps/agent run typecheck"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
