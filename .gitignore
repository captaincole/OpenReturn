node_modules
web/dist
.mastra
# Env files hold API keys and tokens; only the .env.example templates are committed.
.env*
!.env.example
# Local data: databases, documents, uploads. Every package keeps it in .data/.
.data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.log
cade/src/mastra/public/drafts/
.DS_Store
.claude/*
!.claude/skills/
.vercel
supabase/

# Claude's local scratch space — temp artifacts, screenshots, backups. Never committed.
.scratch/

# E2E run folders: data, logs, transcripts, Playwright output.
web/e2e/.run/

# Runtime copy of the blank PDFs, made by cade scripts/syncSources.ts
# from sources (the one copy in git).
cade/src/mastra/public/sources/

# Corpus source documents are not committed: sources keeps their
# sidecars (docId, sourceUrl, sha256), and canon/.data/corpus.db stores the
# PDFs, the cleaned HTML pages and the extracted text. `npm run corpus -- sync`
# restores or downloads a source file when it has to ingest.
sources/**/instructions.pdf
sources/**/publication.pdf
sources/**/instructions.html
sources/**/publication.html
sources/**/*.canonical.txt
