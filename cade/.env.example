# ── Required ────────────────────────────────────────────────────────────────

# Anthropic — powers Cade (Sonnet). The one key the app cannot run without.
# (The judges are Canon's: JUDGE_MODEL lives in canon/.env.development.)
ANTHROPIC_API_KEY=sk-ant-...

# ── Models (REQUIRED — no in-code defaults; startup fails without this) ─────
# One model role, a "provider/model" string resolved through Mastra's
# provider registry (cloud, keyed by the provider's *_API_KEY above).
CADE_MODEL=anthropic/claude-sonnet-4-6    # conversation + document reading (needs vision)

# To run a role against a local or self-hosted OpenAI-compatible server
# (Ollama, vLLM, LM Studio, llama.cpp, Hugging Face endpoint), set its URL —
# the model string then names the model on that server:
# CADE_MODEL=ollama/gemma4:31b
# CADE_MODEL_URL=http://localhost:11434/v1
# CADE_MODEL_API_KEY=                       # only if the server requires one

# ── Optional ────────────────────────────────────────────────────────────────

# Grounding reviews run after every record-ai-decision. "off" skips them;
# the verdict stays "pending". npm run e2e sets this to off.
# DECISION_REVIEW=on

# The embedding model `npm run doctor` checks for. Canon does the retrieval
# and reads its own copy of these settings (canon/.env.development).
# EMBEDDINGS_MODEL=ollama/embeddinggemma-2
# EMBEDDINGS_MODEL_URL=http://localhost:11434

# The agent listens on 127.0.0.1 only. Set MASTRA_HOST (e.g. 0.0.0.0) to
# reach it from other machines, and then set AGENT_API_TOKEN too.
# MASTRA_HOST=127.0.0.1

# Shared-token gate for /api/* and /app/* — set this when the agent port is
# reachable beyond localhost (the web app's proxy attaches it server-side).
# Unset = open, which is fine when the agent binds to 127.0.0.1.
# AGENT_API_TOKEN=

# Host names the agent answers to besides localhost / 127.0.0.1 / [::1]
# (comma-separated). Requests with any other Host or Origin get a 403.
# "*.example.com" matches every subdomain (e.g. preview deployments). On a
# shared domain such as *.vercel.app, any site there passes the Origin
# check, so also set AGENT_API_TOKEN.
# ALLOWED_HOSTS=

# ── Canon ───────────────────────────────────────────────────────────────────
# Where Cade reaches Canon (the reference library, the judges) over MCP, and
# the token to attach when Canon enforces CANON_API_TOKEN. One call may take
# minutes on a local model; CANON_TIMEOUT_MS caps it (default 300000, 5 min),
# and CANON_GROUND_MAX_ITERATIONS caps the judges' rounds per review
# (Canon's default is 3).
# CANON_URL=http://127.0.0.1:4112
# CANON_API_TOKEN=
# CANON_TIMEOUT_MS=300000
# CANON_GROUND_MAX_ITERATIONS=3

# ── Local data files (SQLite + blobs) ───────────────────────────────────────
# Everything persistent lives under .data/. Absolute paths recommended — the
# module-relative defaults resolve differently inside Mastra's bundled output
# than in tsx scripts, so pinning them here keeps every entry point on the
# same files.
APP_DB_PATH=/absolute/path/to/cade/.data/app.db
MASTRA_DB_PATH=/absolute/path/to/cade/.data/mastra.db
DOCUMENTS_PATH=/absolute/path/to/cade/.data/documents

# ── Dev knobs ───────────────────────────────────────────────────────────────

# Set to "true" locally to enable verbose tracing (dumps full agent I/O
# including base64 uploads to stdout). Leave unset or "false" in production.
# `mastra dev` sets this automatically.
MASTRA_DEV=true
