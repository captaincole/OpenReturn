# ── Models (REQUIRED — no in-code defaults; startup fails without this) ────
# The judges: query formulation, risk assessment, rulings, and the Ask The
# Tax Code answerer. A "provider/model" string resolved through Mastra's
# provider registry (cloud, keyed by the provider's *_API_KEY).
ANTHROPIC_API_KEY=sk-ant-...
JUDGE_MODEL=anthropic/claude-haiku-5-5

# To run the judges on a local or self-hosted OpenAI-compatible server:
# JUDGE_MODEL=ollama/gemma4:31b
# JUDGE_MODEL_URL=http://localhost:11434/v1
# JUDGE_MODEL_API_KEY=                      # only if the server requires one

# ── Retrieval ───────────────────────────────────────────────────────────────
# Local embedding model via Ollama (`ollama pull embeddinggemma-2`). Without
# Ollama running, search degrades to FTS5 keyword-only. Defaults shown.
# EMBEDDINGS_MODEL=ollama/embeddinggemma-2
# EMBEDDINGS_MODEL_URL=http://localhost:11434

# Contextual-summary model for corpus ingest (corpus sync). Defaults to Haiku.
# REFDOCS_MODEL=claude-opus-5

# ── Local data files ────────────────────────────────────────────────────────
# Absolute paths recommended: module-relative defaults resolve differently
# inside Mastra's bundled output than in tsx scripts.
CORPUS_DB_PATH=/absolute/path/to/canon/.data/corpus.db
MASTRA_DB_PATH=/absolute/path/to/canon/.data/mastra.db

# ── Server ──────────────────────────────────────────────────────────────────
# CANON_PORT=4112
# Optional shared secret: when set, /api/* and /app/* (the library, the MCP
# endpoint, the Ask workflow) require `Authorization: Bearer <token>`. Set
# it when Canon is reachable beyond localhost; the web app's proxy attaches
# it server-side. Unset = open, which is fine when Canon binds to 127.0.0.1.
# CANON_API_TOKEN=
# Host names Canon answers to besides localhost / 127.0.0.1 / [::1]
# (comma-separated). Requests with any other Host or Origin get a 403.
# "*.example.com" matches every subdomain (e.g. preview deployments). On a
# shared domain such as *.vercel.app, any site there passes the Origin
# check, so also set CANON_API_TOKEN.
# ALLOWED_HOSTS=
MASTRA_DEV=true
